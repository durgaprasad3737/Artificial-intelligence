water_mammal(X) :- class(X, mammal), lives_in(X, water).

flying(X) :- instance(X, bird), movement(X, fly).
flying(X):- instance(X,Y),class(Y,mammal),X\=Y.
walk(X):- instance(X,Y),class(Y,vertebrate),movement(X,walk).
